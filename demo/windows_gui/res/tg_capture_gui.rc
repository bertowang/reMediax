// tg_capture_gui 资源脚本（UTF-8）。界面布局可在 VS2022「资源视图」里可视化编辑。
#pragma code_page(65001)

#include <windows.h>
#include "resource.h"
#include "version.h"   // 由 CMake 从 version.h.in 生成，版本号只在根 CMakeLists.txt 的 project(VERSION) 定义

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED

IDI_APP ICON "app.ico"

// 应用清单：Common Controls v6（现代控件外观）+ DPI 感知 + UTF-8 活动代码页
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "tg_capture_gui.manifest"

/////////////////////////////////////////////////////////////////////////////
// 主界面：左列 = 开播配置（开播前设置），右列 = 直播中控制 + 运行状态 + 日志
IDD_MAIN DIALOGEX 0, 0, 640, 268
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_THICKFRAME
EXSTYLE WS_EX_APPWINDOW
CAPTION "TGCapture 开播测试工具"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x1
BEGIN
    // ---------------------------------------------------------------- ① 视频源
    GROUPBOX        "① 视频源", IDC_STATIC, 7, 5, 315, 57
    LTEXT           "采集对象", IDC_STATIC, 14, 18, 34, 8
    CONTROL         "整个显示器", IDC_SRC_MONITOR, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 58, 17, 62, 10
    CONTROL         "指定窗口", IDC_SRC_WINDOW, "Button", BS_AUTORADIOBUTTON, 124, 17, 60, 10
    LTEXT           "显示器", IDC_TARGET_LABEL, 14, 32, 34, 8, WS_GROUP
    COMBOBOX        IDC_MONITOR_LIST, 58, 30, 258, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_WINDOW_LIST, 58, 30, 216, 200, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "刷新", IDC_WINDOW_REFRESH, 278, 29, 38, 14
    LTEXT           "采集方式", IDC_STATIC, 14, 47, 34, 8
    COMBOBOX        IDC_CAP_MODE, 58, 45, 116, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "性能模式", IDC_STATIC, 182, 47, 34, 8
    COMBOBOX        IDC_PERF_MODE, 218, 45, 98, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    // ---------------------------------------------------------------- ② 音频源
    GROUPBOX        "② 音频源（可同时开启，内核自动混音）", IDC_STATIC, 7, 66, 315, 44
    AUTOCHECKBOX    "麦克风", IDC_MIC_ENABLE, 14, 79, 44, 10
    COMBOBOX        IDC_MIC_DEVICE, 62, 77, 186, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "静音", IDC_MIC_MUTE, 254, 79, 30, 10
    PUSHBUTTON      "刷新", IDC_AUDIO_REFRESH, 286, 76, 30, 14
    AUTOCHECKBOX    "系统声音", IDC_SPK_ENABLE, 14, 94, 46, 10
    COMBOBOX        IDC_SPK_DEVICE, 62, 92, 186, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "静音", IDC_SPK_MUTE, 254, 94, 30, 10

    // ---------------------------------------------------------------- ③ 编码与输出
    GROUPBOX        "③ 编码与输出", IDC_STATIC, 7, 114, 315, 120
    LTEXT           "输出地址", IDC_STATIC, 14, 128, 34, 8
    COMBOBOX        IDC_OUTPUT_URL, 58, 126, 216, 120, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "浏览…", IDC_OUTPUT_BROWSE, 278, 125, 38, 14
    LTEXT           "封装格式", IDC_STATIC, 14, 143, 34, 8
    COMBOBOX        IDC_MUXER, 58, 141, 92, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "分辨率", IDC_STATIC, 158, 143, 26, 8
    COMBOBOX        IDC_RESOLUTION, 186, 141, 130, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "视频编码", IDC_STATIC, 14, 158, 34, 8
    COMBOBOX        IDC_VCODEC, 58, 156, 150, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "帧率", IDC_STATIC, 216, 158, 18, 8
    COMBOBOX        IDC_FPS, 236, 156, 80, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "视频码率", IDC_STATIC, 14, 173, 34, 8
    EDITTEXT        IDC_VBITRATE, 58, 171, 40, 12, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "kbps", IDC_STATIC, 101, 173, 20, 8
    LTEXT           "GOP", IDC_STATIC, 158, 173, 18, 8
    EDITTEXT        IDC_GOP, 186, 171, 36, 12, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "帧（关键帧间隔）", IDC_STATIC, 226, 173, 90, 8
    LTEXT           "音频编码", IDC_STATIC, 14, 188, 34, 8
    COMBOBOX        IDC_ACODEC, 58, 186, 92, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "音频码率", IDC_STATIC, 158, 188, 34, 8
    COMBOBOX        IDC_ABITRATE, 194, 186, 60, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "kbps", IDC_STATIC, 258, 188, 20, 8
    LTEXT           "画面旋转", IDC_STATIC, 14, 203, 34, 8
    COMBOBOX        IDC_ROTATION, 58, 201, 92, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "画面翻转", IDC_STATIC, 158, 203, 34, 8
    COMBOBOX        IDC_FLIP, 194, 201, 92, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "断流告警", IDC_STATIC, 14, 218, 34, 8
    LTEXT           "音频", IDC_STATIC, 58, 218, 16, 8
    EDITTEXT        IDC_A_TIMEOUT, 76, 216, 40, 12, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "视频", IDC_STATIC, 124, 218, 16, 8
    EDITTEXT        IDC_V_TIMEOUT, 142, 216, 40, 12, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "毫秒没有新数据即告警", IDC_STATIC, 188, 218, 128, 8

    // ---------------------------------------------------------------- 底部按钮
    PUSHBUTTON      "开始直播", IDC_START, 7, 240, 110, 22
    PUSHBUTTON      "暂停画面", IDC_PAUSE_VIDEO, 123, 240, 80, 22
    PUSHBUTTON      "打开输出目录", IDC_OPEN_OUTPUT_DIR, 209, 240, 80, 22

    // ---------------------------------------------------------------- ④ 画面控制
    GROUPBOX        "④ 画面控制（暂停图片开播前可设；Logo 直播中操作）", IDC_STATIC, 330, 5, 303, 75
    LTEXT           "暂停图片", IDC_STATIC, 338, 19, 36, 8
    EDITTEXT        IDC_PAUSE_PIC, 376, 17, 170, 12, ES_AUTOHSCROLL
    PUSHBUTTON      "浏览…", IDC_PAUSE_PIC_BROWSE, 550, 16, 38, 14
    PUSHBUTTON      "应用", IDC_PAUSE_PIC_APPLY, 592, 16, 34, 14
    LTEXT           "Logo 图片", IDC_STATIC, 338, 34, 36, 8
    EDITTEXT        IDC_LOGO_PATH, 376, 32, 170, 12, ES_AUTOHSCROLL
    PUSHBUTTON      "浏览…", IDC_LOGO_BROWSE, 550, 31, 38, 14
    LTEXT           "序号", IDC_STATIC, 338, 49, 18, 8
    COMBOBOX        IDC_LOGO_INDEX, 376, 47, 32, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "位置", IDC_STATIC, 414, 49, 18, 8
    COMBOBOX        IDC_LOGO_POS, 434, 47, 64, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "X", IDC_STATIC, 504, 49, 8, 8
    EDITTEXT        IDC_LOGO_X, 514, 47, 30, 12, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Y", IDC_STATIC, 550, 49, 8, 8
    EDITTEXT        IDC_LOGO_Y, 560, 47, 30, 12, ES_AUTOHSCROLL | ES_NUMBER
    PUSHBUTTON      "添加 Logo", IDC_LOGO_ADD, 376, 62, 56, 14
    PUSHBUTTON      "更新 Logo", IDC_LOGO_UPDATE, 436, 62, 56, 14
    PUSHBUTTON      "删除 Logo", IDC_LOGO_REMOVE, 496, 62, 56, 14

    // ---------------------------------------------------------------- 运行状态
    GROUPBOX        "运行状态", IDC_STATUS_GROUP, 330, 84, 303, 74
    LTEXT           "● 未开播", IDC_STATUS, 338, 96, 288, 12, SS_PATHELLIPSIS | SS_NOPREFIX
    EDITTEXT        IDC_STATS, 338, 110, 288, 44, ES_MULTILINE | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP

    // ---------------------------------------------------------------- 日志
    GROUPBOX        "日志（内核日志 + SDK 回调）", IDC_LOG_GROUP, 330, 162, 303, 100
    LTEXT           "级别", IDC_STATIC, 338, 176, 18, 8
    COMBOBOX        IDC_LOG_LEVEL, 358, 174, 60, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "清空", IDC_LOG_CLEAR, 532, 173, 40, 14
    PUSHBUTTON      "日志目录", IDC_OPEN_LOG_DIR, 576, 173, 50, 14
    EDITTEXT        IDC_LOG, 338, 190, 288, 68, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
END

/////////////////////////////////////////////////////////////////////////////
// 版本信息
VS_VERSION_INFO VERSIONINFO
 FILEVERSION TGUI_VER_MAJOR, TGUI_VER_MINOR, TGUI_VER_PATCH, 0
 PRODUCTVERSION TGUI_VER_MAJOR, TGUI_VER_MINOR, TGUI_VER_PATCH, 0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "Tencent"
            VALUE "FileDescription", "TGCapture 开播测试工具"
            VALUE "FileVersion", TGUI_VER_STR
            VALUE "InternalName", "tg_capture_gui"
            VALUE "OriginalFilename", "tg_capture_gui.exe"
            VALUE "ProductName", "TGCapture"
            VALUE "ProductVersion", TGUI_VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
